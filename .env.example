# Pilih backend mana yang dipakai app: development | sit | uat | production.
# Lihat src/config/apiEnvironments.ts untuk base URL tiap environment.
# Default kalau tidak di-set: "development" (npx expo start) / mengikuti
# APP_VARIANT saat build EAS (lihat app.config.ts).
APP_ENV=development

# Override base URL API secara manual (opsional). Berguna kalau:
# - testing di HP fisik lewat IP LAN mesin dev, mis. http://192.168.1.10:8080/api/v1
# - butuh nunjuk ke backend yang tidak ada di API_ENVIRONMENTS
# Kalau di-set, ini SELALU menang dari APP_ENV di atas.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
